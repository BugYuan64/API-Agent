    "/api/chat/ask/stream": {
      "get": {
        "summary": "流式问答（SSE，后端转发 RAG）",
        "operationId": "chatAskStream",
        "x-protocol": "sse",
        "parameters": [
          {
            "name": "token",
            "in": "header",
            "required": true,
            "description": "登录返回的 JWT；跑测试前替换为真实 token",
            "schema": {
              "type": "string"
            },
            "example": "REPLACE_WITH_TOKEN"
          },
          {
            "name": "question",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "CRM系统有哪些核心功能模块？"
          }
        ],
        "responses": {
          "200": {
            "description": "SSE 事件流（data:<分片>\\n\\n）",
            "content": {
              "text/event-stream": {}
            }
          },
          "401": {
            "description": "未登录"
          }
        },
        "x-test-cases": [
          {
            "name": "SSE-无 token 拦截",
            "method": "GET",
            "path": "/api/chat/ask/stream?question=hi",
            "assertions": [
              {
                "kind": "status",
                "expected": 401
              },
              {
                "kind": "json_equals",
                "pointer": "/code",
                "expected": "401"
              }
            ]
          },
          {
            "name": "SSE-正常提问（需 RAG 在线）",
            "method": "GET",
            "protocol": "sse",
            "path": "/api/chat/ask/stream?question=%E4%BD%A0%E5%A5%BD",
            "headers": {
              "token": "REPLACE_WITH_TOKEN"
            },
            "assertions": [
              {
                "kind": "status",
                "expected": 200
              }
            ]
          }
        ]
      }
    },
    "/api/ws/chat": {
      "get": {
        "summary": "实时双向对话（WebSocket）",
        "operationId": "chatWebSocket",
        "x-protocol": "websocket",
        "x-messages": [
          "{\"type\":\"ping\"}",
          "{\"type\":\"peers\"}",
          "你好，来自 API-Agent"
        ],
        "description": "实时双向 WebSocket 端点（ws://127.0.0.1:8088/api/ws/chat 或直连 ws://127.0.0.1:8081/api/ws/chat）。支持按房间隔离广播、welcome/join/leave 系统通知、ping/pong 心跳、peers 在线列表查询、纯文本与自定义 JSON 消息及空白消息 error 反馈；携带非法 token 时握手返回 HTTP 401，未带 token 允许外部调试端接入。",
        "parameters": [
          {
            "name": "token",
            "in": "header",
            "required": false,
            "description": "可选 JWT（亦可放 Authorization: Bearer 或 ?token）；携带非法 token 握手返回 401",
            "schema": {
              "type": "string"
            },
            "example": "REPLACE_WITH_TOKEN"
          },
          {
            "name": "room",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "lobby"
            },
            "example": "api-agent-test"
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "API测试端"
          },
          {
            "name": "client",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "crm",
                "external",
                "api-agent"
              ]
            },
            "example": "api-agent"
          },
          {
            "name": "echo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "true"
            },
            "example": "true"
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket 握手升级成功"
          },
          "401": {
            "description": "携带非法或过期 token，拒绝握手"
          }
        },
        "x-test-cases": [
          {
            "name": "WebSocket-鉴权建连与心跳/成员查询",
            "method": "GET",
            "protocol": "websocket",
            "path": "/api/ws/chat?room=api-agent-test&client=crm",
            "headers": {
              "token": "REPLACE_WITH_TOKEN"
            },
            "messages": [
              "{\"type\":\"ping\"}",
              "{\"type\":\"peers\"}",
              "你好，来自 API-Agent 鉴权端"
            ],
            "assertions": [
              {
                "kind": "status",
                "expected": 101
              },
              {
                "kind": "event_count",
                "expected": 3
              },
              {
                "kind": "message_contains",
                "expected": "\"type\":\"welcome\""
              },
              {
                "kind": "message_contains",
                "expected": "\"type\":\"pong\""
              }
            ]
          },
          {
            "name": "WebSocket-外部匿名端自定义JSON与空白错误校验",
            "method": "GET",
            "protocol": "websocket",
            "path": "/api/ws/chat?room=api-agent-test&name=ExternalPeer&client=external",
            "messages": [
              "{\"customKey\":\"customVal\",\"n\":42}",
              "   "
            ],
            "assertions": [
              {
                "kind": "status",
                "expected": 101
              },
              {
                "kind": "message_contains",
                "expected": "\"type\":\"welcome\""
              },
              {
                "kind": "message_contains",
                "expected": "\"format\":\"json\""
              },
              {
                "kind": "message_contains",
                "expected": "消息内容不能为空"
              }
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
