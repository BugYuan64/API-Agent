            "name": "客户详情-id=1 成功",
            "method": "GET",
            "path": "/api/customer/1",
            "headers": {
              "token": "REPLACE_WITH_TOKEN"
            },
            "assertions": [
              {
                "kind": "status",
                "expected": 200
              },
              {
                "kind": "json_equals",
                "pointer": "/code",
                "expected": "200"
              },
              {
                "kind": "json_equals",
                "pointer": "/data/id",
                "expected": 1
              }
            ]
          },
          {
            "name": "客户详情-id 不存在（HTTP 200 + code 500）",
            "method": "GET",
            "path": "/api/customer/999999",
            "headers": {
