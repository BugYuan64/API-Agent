            },
            "assertions": [
              {
                "kind": "status",
                "expected": 200
              },
              {
                "kind": "json_equals",
                "pointer": "/code",
                "expected": "500"
              },
              {
                "kind": "json_equals",
                "pointer": "/msg",
                "expected": "客户不存在"
              }
            ]
          }
        ]
      },
      "put": {
        "summary": "编辑客户（乐观锁 + 全量覆盖）",
        "operationId": "updateCustomer",
        "description": "写操作。注意已知缺陷：不传 status 会触发 Column 'status' cannot be null 并泄露 SQL 堆栈。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "编辑结果"
          },
          "401": {
            "description": "未登录"
          }
        },
        "x-test-cases": [
          {
            "name": "编辑-不传 status 触发 NOT NULL 缺陷（已知缺陷回归）",
            "method": "PUT",
            "path": "/api/customer/6",
            "headers": {
              "token": "REPLACE_WITH_TOKEN"
            },
            "body": {
              "name": "缺陷回归",
              "company": "缺陷回归公司",
              "email": "bug-status@example.com",
              "phone": "13900009999"
            },
            "assertions": [
              {
                "kind": "status",
                "expected": 200
              },
              {
                "kind": "json_equals",
                "pointer": "/code",
                "expected": "500"
              },
              {
                "kind": "contains",
                "expected": "status"
              }
            ]
          },
          {
            "name": "编辑-id 不存在",
            "method": "PUT",
            "path": "/api/customer/999999",
            "headers": {
              "token": "REPLACE_WITH_TOKEN"
            },
            "body": {
              "name": "不存在",
              "company": "不存在公司",
              "email": "no-such@example.com",
              "phone": "13900009999",
              "status": "active"
            },
            "assertions": [
              {
                "kind": "status",
                "expected": 200
              },
              {
                "kind": "json_equals",
                "pointer": "/code",
                "expected": "500"
              },
              {
                "kind": "json_equals",
                "pointer": "/msg",
                "expected": "客户不存在"
              }
            ]
          }
        ]
      },
      "delete": {
        "summary": "软删除客户",
        "operationId": "deleteCustomer",
        "description": "写操作。软删除（UPDATE status='inactive'），关联商机客户拒绝删除，重复删除幂等。",
        "responses": {
          "200": {
            "description": "删除结果"
          },
          "401": {
            "description": "未登录"
          }
        },
        "x-test-cases": [
