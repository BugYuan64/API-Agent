{
  "openapi": "3.1.0",
  "info": {
    "title": "CRM 系统接口文档（测试用例版）",
    "version": "1.0.0",
    "description": "根据 docs/CRM接口测试清单.md 与 crm-backend WebSocket 实现生成，供 API-Agent /testcases 文档识别与自动用例执行（覆盖 HTTP、SSE 与 WebSocket /api/ws/chat）。\n\n使用方式：\n1. 登录换取 token：POST http://127.0.0.1:8088/api/user/login  body {\"email\":\"admin@elcrms.com\",\"password\":\"123456\"}\n2. 把本文件中所有 REPLACE_WITH_TOKEN 字符串替换为真实 token（24h 有效）。\n3. 在 /testcases 上传本文件，origin 填 http://127.0.0.1:8088。\n4. 默认跳过写用例（POST/PUT/DELETE 及带发送消息的 WebSocket）；要跑写用例与 WebSocket 发消息需勾选 allow_writes，并在事后清理写入数据（见清单第八节）。\n\n注意：CRM HTTP 业务错误的 HTTP 状态码仍是 200，断言必须看 body.code（字符串），不能只看 HTTP status；WebSocket 握手升级成功状态为 101，携带非法 token 时握手返回 401。"
  },
  "x-target-origin": "http://127.0.0.1:8088",
  "x-auth-note": "HTTP 鉴权请求头名为 token（不是 Authorization: Bearer），白名单：/api/user/register、/api/user/login、/api/ws/**、/error。WebSocket /api/ws/chat 由专用握手拦截器校验 token（请求头 token / Authorization: Bearer / 查询参数 ?token），带非法 token 返 401，未带 token 允许外部调试端接入。",
  "paths": {
    "/api/user/login": {
      "post": {
        "summary": "登录换取 JWT",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "admin@elcrms.com",
                "password": "123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功（业务错误也返回 HTTP 200，需断言 body.code）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        },
        "x-test-cases": [
          {
            "name": "登录成功-admin",
            "method": "POST",
            "path": "/api/user/login",
            "body": {
              "email": "admin@elcrms.com",
              "password": "123456"
            },
            "assertions": [
              {
                "kind": "status",
                "expected": 200
              },
              {
                "kind": "json_equals",
                "pointer": "/code",
                "expected": "200"
              },
              {
                "kind": "json_equals",
                "pointer": "/data/name",
                "expected": "系统管理员"
              }
            ]
          },
          {
            "name": "登录-密码错误",
            "method": "POST",
            "path": "/api/user/login",
            "body": {
              "email": "admin@elcrms.com",
              "password": "wrong-password"
            },
            "assertions": [
              {
                "kind": "status",
                "expected": 200
              },
              {
                "kind": "json_equals",
                "pointer": "/code",
                "expected": "500"
              },
              {
                "kind": "json_equals",
                "pointer": "/msg",
                "expected": "邮箱或密码错误"
              }
            ]
          }
        ]
      }
    },
    "/api/user/register": {
      "post": {
        "summary": "用户注册",
        "operationId": "register",
        "description": "写操作用例使用 apireg+*@example.com 邮箱段，跑完需按清单第八节清理。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "name": "接口测试用户",
                "email": "apireg-openapi@example.com",
                "phone": "13900003333",
                "company": "测试公司",
                "password": "test123456",
                "confirmPassword": "test123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          }
        },
        "x-test-cases": [
          {
            "name": "注册-邮箱已注册",
            "method": "POST",
            "path": "/api/user/register",
            "body": {
              "name": "重复邮箱",
              "email": "admin@elcrms.com",
              "phone": "13900003333",
              "company": "测试公司",
              "password": "test123456",
              "confirmPassword": "test123456"
            },
            "assertions": [
              {
                "kind": "status",
                "expected": 200
              },
              {
                "kind": "json_equals",
                "pointer": "/code",
                "expected": "500"
              },
              {
                "kind": "contains",
                "expected": "该邮箱已被注册"
              }
            ]
          },
          {
            "name": "注册-成功（写操作，需 allow_writes + 事后清理）",
            "method": "POST",
            "path": "/api/user/register",
            "body": {
              "name": "接口测试用户",
              "email": "apireg-openapi@example.com",
              "phone": "13900003333",
              "company": "测试公司",
              "password": "test123456",
              "confirmPassword": "test123456"
            },
            "assertions": [
              {
                "kind": "status",
                "expected": 200
              },
              {
                "kind": "json_equals",
                "pointer": "/code",
                "expected": "200"
              }
            ]
          }
        ]
      }
    },
    "/api/customer/list": {
      "get": {
        "summary": "客户分页 + 关键词查询",
        "operationId": "customerList",
        "parameters": [
          {
            "name": "token",
            "in": "header",
            "required": true,
            "description": "登录返回的 JWT；跑测试前替换为真实 token",
            "schema": {
              "type": "string"
            },
            "example": "REPLACE_WITH_TOKEN"
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "华为"
          },
          {
            "name": "pageNum",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "example": 1
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            },
            "example": 3
          }
        ],
        "responses": {
          "200": {
            "description": "分页结果（PageHelper PageInfo）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResult"
                }
              }
            }
          },
          "401": {
            "description": "未登录 / token 失效"
          }
        },
        "x-test-cases": [
          {
            "name": "客户列表-无 token 拦截",
            "method": "GET",
            "path": "/api/customer/list",
            "assertions": [
              {
                "kind": "status",
                "expected": 401
              },
              {
                "kind": "json_equals",
                "pointer": "/code",
                "expected": "401"
              },
              {
                "kind": "json_equals",
                "pointer": "/msg",
                "expected": "未登录，请先登录"
              }
            ]
          },
          {
            "name": "客户列表-默认分页",
            "method": "GET",
            "path": "/api/customer/list?pageNum=1&pageSize=3",
            "headers": {
              "token": "REPLACE_WITH_TOKEN"
            },
            "assertions": [
              {
                "kind": "status",
                "expected": 200
              },
              {
                "kind": "json_equals",
                "pointer": "/code",
                "expected": "200"
              },
              {
                "kind": "json_equals",
                "pointer": "/data/pageNum",
                "expected": 1
              },
              {
                "kind": "json_equals",
                "pointer": "/data/pageSize",
                "expected": 3
              }
            ]
          }
        ]
      }
    },
    "/api/customer/{id}": {
      "parameters": [
        {
          "name": "token",
          "in": "header",
