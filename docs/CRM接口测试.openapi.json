          },
          {
            "name": "删除-id 不存在",
            "method": "DELETE",
            "path": "/api/customer/999999",
            "headers": {
              "token": "REPLACE_WITH_TOKEN"
            },
            "assertions": [
              {
                "kind": "status",
                "expected": 200
              },
              {
                "kind": "json_equals",
                "pointer": "/code",
                "expected": "500"
              },
              {
                "kind": "json_equals",
                "pointer": "/msg",
                "expected": "客户不存在"
              }
            ]
          }
        ]
      }
    },
