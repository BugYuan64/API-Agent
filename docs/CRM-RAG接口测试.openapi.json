{
  "openapi": "3.1.0",
  "info": {
    "title": "CRM RAG 服务接口测试文档",
    "version": "1.0.0",
    "description": "本机 Docker 部署的 RAG 智能问答服务（FastAPI）接口定义，每个接口附 2 条测试用例。\n\n该服务无鉴权，直连端口 8002（容器内 8000）。Nginx 只代理 Java 后端的 /api/，因此本服务的接口不能通过 8088 访问，测试时 origin 请填 http://127.0.0.1:8002。\n\n响应约定：\n- /health 返回 {\"status\":\"ok\"}\n- /ask 返回 {\"answer\":\"...\"}\n- /ask/stream 返回 text/event-stream，事件格式 data: <分片>\\n\\n，含 [START]/[END] 标记\n\n错误约定：FastAPI 标准语义，400 为业务校验（如空问题），422 为请求体结构校验失败。"
  },
  "servers": [
    { "url": "http://127.0.0.1:8002", "description": "RAG 服务直连（宿主机 8002 → 容器 8000）" }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "健康检查",
        "operationId": "health",
        "description": "用于容器健康探针，无鉴权。",
        "responses": {
          "200": {
            "description": "服务正常",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          }
        },
        "x-test-cases": [
          {
            "name": "健康检查-正常",
            "method": "GET",
            "path": "/health",
            "assertions": [
              { "kind": "status", "expected": 200 },
              { "kind": "json_equals", "pointer": "/status", "expected": "ok" }
            ]
          },
          {
            "name": "健康检查-错误方法 POST 返回 405",
            "method": "POST",
            "path": "/health",
            "assertions": [
              { "kind": "status", "expected": 405 }
            ]
          }
        ]
      }
    },
    "/ask": {
      "post": {
        "summary": "非流式问答",
        "operationId": "ask",
        "description": "先做向量检索（Redis Stack，text-embedding-v4），命中知识库则拼入 prompt，未命中或向量库不可用时降级为纯大模型直答。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/QuestionRequest" },
              "example": { "question": "CRM系统有哪些核心功能模块？" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "完整回答",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AnswerResponse" } }
            }
          },
          "400": { "description": "问题为空（question 为空字符串）" },
          "422": { "description": "请求体校验失败（缺 question 或类型错误）" }
        },
        "x-test-cases": [
          {
            "name": "问答-正常提问",
            "method": "POST",
            "path": "/ask",
            "body": { "question": "CRM系统有哪些核心功能模块？" },
            "assertions": [
              { "kind": "status", "expected": 200 },
              { "kind": "contains", "expected": "\"answer\"" }
            ]
          },
          {
            "name": "问答-空问题返回 400",
            "method": "POST",
            "path": "/ask",
            "body": { "question": "" },
            "assertions": [
              { "kind": "status", "expected": 400 },
              { "kind": "json_equals", "pointer": "/detail", "expected": "问题不能为空" }
            ]
          }
        ]
      }
    },
    "/ask/stream": {
      "post": {
        "summary": "流式问答（SSE）",
        "operationId": "askStream",
        "description": "流式返回回答分片，分片粒度较细（常见单字/双字），一次回答约 300+ 个事件。Java 后端的 /api/chat/ask/stream 会转发本接口并过滤 [START]/[END] 标记。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/QuestionRequest" },
              "example": { "question": "你好" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE 事件流",
            "content": {
              "text/event-stream": { "schema": { "type": "string" } }
            }
          },
          "400": { "description": "问题为空" },
          "422": { "description": "请求体校验失败" }
        },
        "x-test-cases": [
          {
            "name": "流式问答-正常提问",
            "method": "POST",
            "protocol": "sse",
            "path": "/ask/stream",
            "body": { "question": "你好" },
            "assertions": [
              { "kind": "status", "expected": 200 },
              { "kind": "event_count", "expected": 1 }
            ]
          },
          {
            "name": "流式问答-缺 question 返回 422",
            "method": "POST",
            "path": "/ask/stream",
            "body": {},
            "assertions": [
              { "kind": "status", "expected": 422 },
              { "kind": "json_equals", "pointer": "/detail/0/type", "expected": "missing" }
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "QuestionRequest": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "question": { "type": "string", "example": "CRM系统有哪些核心功能模块？" }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ok" }
        }
      },
      "AnswerResponse": {
        "type": "object",
        "properties": {
          "answer": { "type": "string" }
        }
      }
    }
  }
}
