# Copy to .env in the project root. Environment variables take precedence.
# Paths are resolved relative to the project root, not the shell directory.
APP_NAME=API-Agent
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/api_agent.db
ARTIFACT_DIR=data/artifacts

# Optional HTTP(S) target origin allowlist (JSON array).
# Empty [] (default): allow any valid HTTP(S)/WS(S) domain, LAN IP, loopback, or public IP.
# Non-empty: restrict outbound console/execution/stream/agent targets to listed origins.
TARGET_ALLOWED_ORIGINS=[]
# Only these environment variable NAMES may be referenced by plan.auth_ref.
TARGET_AUTH_ENV_VARS=[]
# false (default): ignore system/environment HTTP(S)_PROXY settings to avoid accidental proxy interception.
# true: follow system/environment proxy variables for outbound HTTP/SSE/WS/Postman/LLM requests.
TRUST_SYSTEM_PROXY=false
# Empty uses .cache/tools/postman/postman.exe; never point to a shell launcher.
POSTMAN_CLI_PATH=
# false (default): keep response headers and body in run results so the target's
# actual reply is visible. true: pass --reporter-json-omitAllHeadersAndBody and
# return only status/timing/assertion verdicts. Enable only when the target's
# payload must never leave the process.
OMIT_RESPONSE_PAYLOAD=false

# Frontend hosting: production build output served by FastAPI at the same origin.
# Empty string disables frontend hosting entirely (the API stays available).
FRONTEND_DIST=frontend/dist

# Long-connection (SSE / WebSocket) limits.
# Max concurrent in-process stream sessions; protects the local socket budget.
STREAM_MAX_SESSIONS=4
# Per-session cumulative received-bytes cap; hitting it ends the session with
# stop_reason=limits_exceeded (distinct from target_closed / deadline_exceeded).
STREAM_MAX_BYTES=8388608
